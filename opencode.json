{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "default_agent": "plan",
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek V3"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek R1"
        }
      }
    }
  },
  "instructions": [
    ".agents/AGENTS.md",
    ".agents/knowledge/INDEX.md",
    ".agents/knowledge/conventions.md"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "nixos-rebuild switch",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "nixos-rebuild boot",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push --force",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dd if=/dev/zero of=/dev/sda",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl * | sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shutdown",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "poweroff",
      "effect": "allow"
    }
  ],
  "agents": {
    "plan": {
      "system": "开工前互查:\n1. git status + git branch -a → 确认没有对方(几助手)新建/残留的分支或未提交改动\n2. git log --oneline -10 → 对方最近提交了什么，是否影响本次任务\n3. 扫 requests/pending/ → 有对方留下的待办申请，先处理再开工\n4. 查看 retros/ 最新 3-5 条 → 对方最近在做什么，避免冲突\n5. 查 known-issues.md → 避免已知踩坑\n改完后:\n6. nixos-rebuild build --flake /etc/nixos#NixMEOW 验证\n7. 写复盘到 .agents/knowledge/retros/<date>-<topic>.md\n8. 用 commit.sh 提交 + 推送分支\n"
    }
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ],
      "initialization": {
        "formatting": {
          "command": [
            "nixfmt"
          ]
        },
        "options": {
          "nixos": {
            "expr": "(builtins.getFlake \"/etc/nixos\").nixosConfigurations.NixMEOW.options"
          }
        }
      }
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "rust-analyzer": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "clangd": {
      "command": [
        "clangd"
      ],
      "extensions": [
        ".c",
        ".cpp",
        ".h",
        ".hpp",
        ".cc",
        ".cxx"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".zsh",
        ".bash"
      ]
    },
    "json": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json"
      ]
    }
  },
  "mcp": {
    "servers": {
      "kb": {
        "type": "local",
        "command": [
          "/etc/profiles/per-user/Reiky-REI/bin/python3",
          "/etc/nixos/.agents/tools/kb-mcp/server.py"
        ],
        "disabled": false
      }
    }
  },
  "shell": "/run/current-system/sw/bin/bash",
  "update": "disable"
}
