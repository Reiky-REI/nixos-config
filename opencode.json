{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek V3"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek R1"
        }
      }
    }
  },
  "instructions": [
    ".agents/AGENTS.md",
    ".agents/knowledge/INDEX.md",
    ".agents/knowledge/conventions.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "nixos-rebuild switch": "ask",
      "nixos-rebuild boot": "ask",
      "git push": "ask",
      "rm -rf *": "ask",
      "git push --force": "deny",
      "rm -rf /": "deny",
      "dd if=/dev/zero of=/dev/sda": "deny",
      "curl * | sh": "deny",
      "sudo rm -rf *": "deny"
    }
  },
  "skills": {
    "enabled": [
      "nixos-manager"
    ]
  },
  "shell": "bash",
  "autoupdate": false
}
