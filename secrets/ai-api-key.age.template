# ===== age 密钥模板 (环境变量文件) =====
#
# 复制此文件: cp ai-api-key.age.template ai-api-key-<user>.age
# 加密编辑:   agenix -e ai-api-key-<user>.age -i ~/.ssh/id_ed25519
#
# 加密后的 .age 可安全提交 (明文永不进 git)
#
# 变量名约定: 与消费方保持一致 (如 provider/cc-switch 配置里引用的名字);
# 多用户场景建议带用户名后缀避免互相覆盖:
#
export DEEPSEEK_API_KEY_REIKY="sk-..."
export NIX_ACCESS_TOKEN="ghp_..."
export XIAOMI_API_KEY="..."
export XIAOMI_API_ENDPOINT="..."
