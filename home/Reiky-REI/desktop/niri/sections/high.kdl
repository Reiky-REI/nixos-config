// high.kdl — 高性能档位专属配置
// 配合 base.kdl 使用，提供完整视觉效果（blur、shadow、半透明、动画）

cursor {
    xcursor-theme "MikuCat"
    xcursor-size 32
}

spawn-at-startup "noctalia-shell"
spawn-at-startup "/nix/store/i335n1yrb8s8mk17x1gkl99pij3k5r02-awww-0.12.1/bin/awww-daemon" # 恢复 2026-08-18 (full-path 防 GC/PATH 失效); 内核 7.1.5 后无闪烁
spawn-at-startup "fcitx5"
spawn-at-startup "nm-applet"
// spawn-at-startup "waydroid" "session" "start" # 临时禁用: Waydroid surfaceflinger 崩溃循环疑似白闪元凶 (2026-08-16)
spawn-sh-at-startup "sh -c 'wayvnc 0.0.0.0'"

blur {
  passes 2
  offset 3.0
  noise 0.03
  saturation 1.0
}

output "HDMI-A-3" {
    mode "1920x1080@120.030"
    scale 1.6
    transform "normal"
    position x=1280 y=0
}
output "eDP-1" {
    mode "2560x1600@60.000"
    scale 1.5
}


layout {
    gaps 5
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

    }
    default-column-width { proportion 0.5; }
    focus-ring {
        off
        width 4
        active-color "#fec5f5"
        inactive-color "#363a4f"
    }

    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }

}

// animations {
//     off
// }
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"chrome$"# title="^Picture-in-Pictures$"
    open-floating true
    opacity 0.75
    background-effect {
      blur true
      xray false
    }
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
    background-effect{
      blur true
      xray false
    }
}

window-rule {
    match app-id="zed"
    match app-id="vscode"
    opacity 0.8
    background-effect {
      blur true
      xray false
    }
}

window-rule {
    match app-id="Alacritty"
    match app-id="neovide"
    match app-id="Logseq"
    match app-id="DolPhine"
    match app-id="Bottles"
    match app-id="kitty"
    match app-id="steam"
    opacity 0.75
    background-effect {
      blur true
      xray false
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect{
      blur true
      xray false
    }
}

window-rule {
    match app-id="floating_terminal"
    opacity 0.65
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.6; }
    background-effect{
      blur true
      xray false
    }
}
